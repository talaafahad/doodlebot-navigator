# Copy this file to .env and fill in ONE key. .env is git-ignored, never commit it.
# With no key, Doodlebot still answers from its offline script.

# Option A: Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Option B: OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_TTS_VOICE= 
# coral   -> 	warm and friendly (current)
# nova    ->	bright, young and energetic, probably the “cutest”
# shimmer ->	soft and gentle
# sage	  ->    calm and clear

# PORT=3000
